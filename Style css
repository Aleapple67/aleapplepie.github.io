/* =========================
   RESET DAN PENGATURAN DASAR
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f3f7f2;
    color: #26352c;
    line-height: 1.7;
    min-height: 100vh;
}

img {
    max-width: 100%;
}

/* =========================
   HEADER / HERO
========================= */

.hero {
    background: linear-gradient(135deg, #14532d, #38945b);
    color: white;
    text-align: center;
    padding: 45px 20px;
}

.hero h1 {
    font-size: 36px;
    line-height: 1.3;
    text-shadow: 2px 3px 5px #183b27;
    margin-bottom: 8px;
}

.hero p {
    color: #e0f2e5;
    margin-bottom: 0;
}

/* =========================
   NAVIGASI
========================= */

nav {
    background: #ffffff;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 15px;
    box-shadow: 0 3px 10px #00000012;
    position: relative;
    z-index: 1;
}

nav a {
    text-decoration: none;
    color: #20623a;
    font-weight: bold;
    padding: 9px 13px;
    border-radius: 10px;
    transition: background-color 0.3s ease,
                color 0.3s ease,
                transform 0.3s ease;
}

nav a:hover,
nav a[aria-current="page"] {
    background: #216e42;
    color: white;
}

nav a:hover {
    transform: translateY(-2px);
}

/* Fokus untuk navigasi dengan keyboard */
nav a:focus-visible,
.btn:focus-visible,
a:focus-visible {
    outline: 3px solid #e9a23b;
    outline-offset: 3px;
}

/* =========================
   KONTEN UTAMA
========================= */

.container {
    width: 90%;
    max-width: 1050px;
    margin: 30px auto;
}

section {
    scroll-margin-top: 20px;
}

h2 {
    color: #216e42;
    margin-bottom: 15px;
    line-height: 1.4;
}

h3 {
    color: #c56b24;
    margin: 22px 0 8px;
    line-height: 1.4;
}

p {
    margin-bottom: 15px;
}

ul,
ol {
    padding-left: 25px;
    margin-bottom: 15px;
}

/* =========================
   GAMBAR BANNER
========================= */

.banner {
    display: block;
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 10px;
    margin: 15px 0 25px;
}

/* =========================
   PANEL DAN KARTU
========================= */

.welcome,
.panel,
.card,
.profile,
.article,
.lyrics {
    background: white;
    border-radius: 10px;
    padding: 25px;
    margin-bottom: 25px;
    box-shadow: 0 4px 14px #193d2510;
}

.welcome .banner {
    margin-bottom: 0;
}

/* =========================
   DAFTAR BERITA
========================= */

.latest-news {
    margin-top: 30px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
}

.card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    margin-bottom: 0;
    transition: transform 0.3s ease,
                box-shadow 0.3s ease;
}

.card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px #193d2520;
}

.card img {
    display: block;
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 15px;
}

.card h3 {
    margin-top: 0;
}

.card p {
    flex-grow: 1;
}

/* =========================
   TOMBOL
========================= */

.btn {
    display: inline-block;
    background: #237444;
    color: white;
    text-decoration: none;
    text-align: center;
    padding: 10px 16px;
    border-radius: 10px;
    margin-top: 8px;
    transition: background-color 0.3s ease,
                transform 0.3s ease;
}

.btn:hover {
    background: #164c2b;
    color: white;
    transform: translateY(-2px);
}

/* =========================
   HALAMAN TENTANG SAYA
========================= */

.profile {
    display: flex;
    gap: 25px;
    align-items: center;
}

.profile-img {
    display: block;
    width: 35%;
    max-height: 300px;
    object-fit: cover;
    border-radius: 10px;
}

/* =========================
   HALAMAN SYAIR LAGU
========================= */

.lyrics {
    text-align: center;
    padding: 35px 20px;
}

.lyrics p {
    margin: 25px 0;
    font-size: 17px;
}

/* =========================
   TEKS TAMBAHAN
========================= */

.subtitle,
.meta,
.source {
    font-size: 13px;
    color: #657568;
}

.meta {
    margin-bottom: 20px;
}

.article {
    padding: 30px;
}

.article .banner {
    margin-top: 0;
}

.article .source {
    margin-top: 25px;
    padding-top: 15px;
    border-top: 1px solid #dce5dc;
}

.article a:not(.btn) {
    color: #216e42;
    overflow-wrap: anywhere;
}

.article a:not(.btn):hover {
    color: #164c2b;
}

/* =========================
   FOOTER
========================= */

footer {
    background: #163d27;
    color: white;
    text-align: center;
    padding: 22px;
    margin-top: 40px;
}

footer p {
    margin: 0;
}

/* =========================
   RESPONSIVE UNTUK HP
========================= */

@media (max-width: 650px) {

    .hero {
        padding: 35px 16px;
    }

    .hero h1 {
        font-size: 28px;
    }

    .container {
        width: 94%;
        margin: 20px auto;
    }

    nav {
        gap: 6px;
        padding: 12px 8px;
    }

    nav a {
        padding: 7px 9px;
        font-size: 14px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .card img {
        height: 190px;
    }

    .profile {
        flex-direction: column;
        align-items: stretch;
    }

    .profile-img {
        width: 100%;
        max-height: 250px;
    }

    .welcome,
    .panel,
    .card,
    .profile,
    .article,
    .lyrics {
        padding: 18px;
    }

    .article {
        overflow-wrap: break-word;
    }

    .banner {
        max-height: 280px;
    }

    .lyrics p {
        font-size: 16px;
    }
}

/* =========================
   PENGATURAN AKSESIBILITAS
========================= */

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
    }
}
