* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #f3f7f2;
  color: #26352c;
  line-height: 1.7;
}

.hero {
  background: linear-gradient(135deg, #14532d, #38945b);
  color: white;
  text-align: center;
  padding: 45px 20px;
}

.hero h1 {
  font-size: 36px;
  text-shadow: 2px 3px 5px #183b27;
  margin-bottom: 8px;
}

.hero p {
  color: #e0f2e5;
}

nav {
  background: #ffffff;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  padding: 15px;
  box-shadow: 0 3px 10px #00000012;
}

nav a {
  text-decoration: none;
  color: #20623a;
  font-weight: bold;
  padding: 9px 13px;
  border-radius: 10px;
  transition: 0.3s;
}

nav a:hover {
  background: #216e42;
  color: white;
}

.container {
  width: 90%;
  max-width: 1050px;
  margin: 30px auto;
}

h2 {
  color: #216e42;
  margin-bottom: 15px;
}

h3 {
  color: #c56b24;
  margin: 22px 0 8px;
}

p {
  margin-bottom: 15px;
}

.banner {
  display: block;
  width: 100%;
  max-height: 400px;
  object-fit: cover;
  border-radius: 10px;
  margin: 15px 0 25px;
}

.welcome,
.panel,
.card,
.profile,
.article,
.lyrics {
  background: white;
  border-radius: 10px;
  padding: 25px;
  margin-bottom: 25px;
  box-shadow: 0 4px 14px #193d2510;
}

.cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.card {
  overflow: hidden;
}

.card img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  border-radius: 10px;
  margin-bottom: 15px;
}

.btn {
  display: inline-block;
  background: #237444;
  color: white;
  text-decoration: none;
  padding: 10px 16px;
  border-radius: 10px;
  margin-top: 8px;
  transition: 0.3s;
}

.btn:hover {
  background: #164c2b;
  transform: translateY(-2px);
}

.profile {
  display: flex;
  gap: 25px;
  align-items: center;
}

.profile-img {
  width: 35%;
  max-height: 300px;
  object-fit: cover;
  border-radius: 10px;
}

ul {
  padding-left: 25px;
  margin-bottom: 15px;
}

.lyrics {
  text-align: center;
  padding: 35px 20px;
}

.lyrics p {
  margin: 25px 0;
  font-size: 17px;
}

.subtitle,
.meta,
.source {
  font-size: 13px;
  color: #657568;
}

.article {
  padding: 30px;
}

.article .banner {
  margin-top: 0;
}

.article .source {
  margin-top: 25px;
  padding-top: 15px;
  border-top: 1px solid #dce5dc;
}

.article a:not(.btn) {
  color: #216e42;
}

footer {
  background: #163d27;
  color: white;
  text-align: center;
  padding: 22px;
  margin-top: 40px;
}

footer p {
  margin: 0;
}

@media (max-width: 650px) {
  .hero h1 {
    font-size: 28px;
  }

  .container {
    width: 94%;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .profile {
    flex-direction: column;
    align-items: stretch;
  }

  .profile-img {
    width: 100%;
    max-height: 250px;
  }

  .welcome,
  .panel,
  .card,
  .profile,
  .article,
  .lyrics {
    padding: 18px;
  }

  nav a {
    padding: 7px 9px;
    font-size: 14px;
  }
}
